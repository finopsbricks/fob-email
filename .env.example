# Optional. fob-email reads accounts from ~/.fob/fob-email/config.yml (see `fob-email config accounts add`).
# For workers and CI, set every account as one JSON map instead:
# FOB_EMAIL_ACCOUNTS={"gmail":{"imap":{"host":"imap.gmail.com","port":993,"user":"me@gmail.com","pass":"<app password>","tls":true},"smtp":{"host":"smtp.gmail.com","port":465,"user":"me@gmail.com","pass":"<app password>","secure":true}}}

# Optional. Use a different config directory (default ~/.fob/fob-email).
# FOB_EMAIL_CONFIG_DIR=
